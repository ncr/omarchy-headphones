#!/usr/bin/env python3
"""Soundcore CLI Control Utility

Control Soundcore headphones and earbuds from the command line on Linux.
"""
import argparse
import sys
import time

try:
    from soundcore_api import (
        find_soundcore_devices, SoundcoreDevice, PRESETS, EQ_FREQUENCIES_10
    )
except ImportError:
    import os
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    from soundcore_api import (
        find_soundcore_devices, SoundcoreDevice, PRESETS, EQ_FREQUENCIES_10
    )


def get_default_device_address(address_arg: str = None) -> str:
    if address_arg:
        return address_arg.upper()
    devices = find_soundcore_devices()
    if not devices:
        sys.exit("Error: No paired Soundcore devices found.")
    for d in devices:
        if d["connected"]:
            return d["address"]
    return devices[0]["address"]


def main():
    parser = argparse.ArgumentParser(description="Soundcore CLI Control Utility")
    subparsers = parser.add_subparsers(dest="command", help="Command to run")

    # devices
    subparsers.add_parser("devices", help="List all paired Soundcore devices")

    # presets
    subparsers.add_parser("presets", help="List all available EQ presets")

    # status
    p_status = subparsers.add_parser("status", help="Show current headphone status")
    p_status.add_argument("device", nargs="?", help="Bluetooth address (optional)")

    # mode
    p_mode = subparsers.add_parser("mode", help="Set listening mode (off, anc, ambient)")
    p_mode.add_argument("value", choices=["off", "anc", "ambient"], help="Mode to set")
    p_mode.add_argument("device", nargs="?", help="Bluetooth address (optional)")

    # anc-level
    p_anc_level = subparsers.add_parser("anc-level", help="Set ANC level (1-5)")
    p_anc_level.add_argument("value", type=int, choices=[1, 2, 3, 4, 5], help="ANC level (1-5)")
    p_anc_level.add_argument("device", nargs="?", help="Bluetooth address (optional)")

    # ambient-level
    p_amb_level = subparsers.add_parser("ambient-level", help="Set Ambient / Transparency level (1-5)")
    p_amb_level.add_argument("value", type=int, choices=[1, 2, 3, 4, 5], help="Ambient level (1-5)")
    p_amb_level.add_argument("device", nargs="?", help="Bluetooth address (optional)")

    # wind
    p_wind = subparsers.add_parser("wind", help="Set Wind Noise Reduction (on, off)")
    p_wind.add_argument("value", choices=["on", "off"], help="Wind noise reduction state")
    p_wind.add_argument("device", nargs="?", help="Bluetooth address (optional)")

    # eq
    p_eq = subparsers.add_parser("eq", help="Set EQ preset (e.g. 'Bass Booster', 'Soundcore Signature', 'Flat')")
    p_eq.add_argument("preset", help="Name of EQ preset")
    p_eq.add_argument("device", nargs="?", help="Bluetooth address (optional)")

    # eq-custom
    p_custom_eq = subparsers.add_parser("eq-custom", help="Set 10-band custom EQ in dB, comma-separated (e.g. 4,3,2,0,0,0,1,2,3,4)")
    p_custom_eq.add_argument("bands", help="10 comma-separated values between -6.0 and +6.0 dB")
    p_custom_eq.add_argument("device", nargs="?", help="Bluetooth address (optional)")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)

    if args.command == "devices":
        devs = find_soundcore_devices()
        if not devs:
            print("No Soundcore devices found.")
            return
        print(f"Found {len(devs)} Soundcore device(s):")
        for d in devs:
            status = "connected" if d["connected"] else "disconnected"
            print(f"  • {d['name']} ({d['address']}) [{status}] (UUID: {d['uuid']})")
        return

    if args.command == "presets":
        print("Available EQ Presets:")
        for name in PRESETS.keys():
            print(f"  • {name}")
        return

    addr = get_default_device_address(getattr(args, "device", None))
    sc = SoundcoreDevice(addr)
    
    if not sc.connect_sync(timeout_sec=4.0):
        sys.exit(f"Failed to connect to Soundcore device at {addr}. (Make sure device is connected or free from other holders)")

    try:
        if args.command == "status":
            print(f"Device:    {addr}")
            print(f"Firmware:  {sc.firmware or 'Unknown'}")
            print(f"Serial:    {sc.serial or 'Unknown'}")
            print(f"Battery:   {sc.battery_level}% {'(Charging)' if sc.battery_charging else ''}")
            print(f"Mode:      {sc.mode.upper()}")
            print(f"ANC Level: {sc.anc_level}/5 {'(Adaptive)' if sc.anc_adaptive else '(Manual)'}")
            print(f"Ambient:   {sc.ambient_level}/5")
            print(f"Wind Red.: {'ON' if sc.wind_noise else 'OFF'}")
            print(f"EQ:        {sc.current_preset}")
            if sc.eq_bands:
                band_str = ", ".join(f"{f}: {g:+.1f}dB" for f, g in zip(EQ_FREQUENCIES_10, sc.eq_bands))
                print(f"Bands:     {band_str}")

        elif args.command == "mode":
            sc.set_listening_mode(args.value)
            print(f"Mode set to: {args.value.upper()}")

        elif args.command == "anc-level":
            sc.set_listening_mode("anc", level=args.value)
            print(f"ANC level set to: {args.value}/5")

        elif args.command == "ambient-level":
            sc.set_listening_mode("ambient", level=args.value)
            print(f"Ambient level set to: {args.value}/5")

        elif args.command == "wind":
            sc.set_listening_mode(sc.mode, wind=(args.value == "on"))
            print(f"Wind noise reduction set to: {args.value.upper()}")

        elif args.command == "eq":
            matches = [k for k in PRESETS if k.lower() == args.preset.lower()]
            if not matches:
                sys.exit(f"Unknown preset '{args.preset}'. Run 'soundcore-ctl presets' to see options.")
            sc.set_preset_eq(matches[0])
            print(f"EQ preset set to: {matches[0]}")

        elif args.command == "eq-custom":
            try:
                values = [float(x.strip()) for x in args.bands.split(",")]
                if len(values) != 10:
                    sys.exit("Error: Must provide exactly 10 values for frequency bands.")
                clamped = [max(-6.0, min(6.0, v)) for v in values]
                sc.set_custom_eq(clamped)
                print(f"Custom 10-band EQ set: {clamped}")
            except ValueError:
                sys.exit("Error: Invalid numbers in band list.")
    finally:
        sc.disconnect()


if __name__ == "__main__":
    main()
