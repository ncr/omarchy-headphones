#!/bin/bash
# Rebuild every picture README shows, after anything about the widget's look
# changed — a label, the icon geometry, a row in the panel, the colours.
#
#   tools/rebuild-visuals [--restart] [--skip-hero]
#
# In order: the two gallery screenshots (JBL earbuds, Sony headset in Ambient),
# the crop of the panel's own key rows taken from the Sony one, the drawn icon
# legend, and — unless --skip-hero — the dark and light hero animations, which
# walk through several Omarchy themes and take a couple of minutes. Needs both
# the JBL and the Sony connected, the widget running, and no fullscreen window
# on the current workspace; refuses otherwise. Runs `omarchy restart shell`
# first if asked with --restart, so a QML change is on screen before the camera.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
skip_hero=0 restart=0
for a in "$@"; do
  case "$a" in
    --skip-hero) skip_hero=1 ;;
    --restart) restart=1 ;;
    -h|--help) sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "rebuild-visuals: unknown argument $a" >&2; exit 2 ;;
  esac
done

if (( restart )); then
  omarchy restart shell
  sleep 14
fi

have() { omarchy-shell omaphones statusFor "$1" 2>/dev/null | grep -qv "no device matching"; }
have jbl || { echo "rebuild-visuals: the JBL earbuds are not connected (statusFor jbl)" >&2; exit 1; }
have sony || { echo "rebuild-visuals: the Sony headset is not connected (statusFor sony)" >&2; exit 1; }

cd "$here"
echo "== gallery"
tools/gallery-shot jbl
tools/gallery-shot sony --mode ambient --rect /tmp/omaphones-sony-rect.txt
read -r cx cy cw ch < /tmp/omaphones-sony-rect.txt

echo "== panel key rows (crop of the Sony shot)"
python3 - "$cx" "$cy" "$cw" "$ch" <<'EOF'
import sys
from PIL import Image
cx, cy, cw, ch = map(int, sys.argv[1:5])
im = Image.open("docs/gallery/sony-wh-ch720n.png")
# The two hint rows are the bottom ~190 px of the card (at scale 2); keep a
# 3 px inset so the card's border stays out of the crop.
crop = im.crop((cx + 3, cy + ch - 190, cx + cw - 3, cy + ch - 3))
crop.save("docs/panel-keys.png")
print("docs/panel-keys.png", crop.size)
EOF

echo "== icon legend"
tools/mark-legend

if (( ! skip_hero )); then
  echo "== hero animations (themes will flip for a minute or two)"
  tools/hero-set
fi

echo "== done"
ls -la docs/gallery/*.png docs/panel-keys.png docs/mark-legend-*.png docs/hero-*.webp 2>/dev/null | awk '{print $5, $9}'
