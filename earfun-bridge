#!/usr/bin/env python3
"""Hold one SPP link to EarFun earbuds and mirror their noise control.

    earfun-bridge <classic-address> <reported-name>

Prints one JSON object per line, and reads one command per line:

    stdout   {"modes": true, "mode": "anc",
              "available": ["off","anc","ambient"]}
             {"modes": false, "error": "..."}
    stdin    set off | set anc | set ambient

Exit codes are BRIDGE.md's: 0 clean stop, 1 transient (the channel never
opened, or closed under us), 3 linked but silent (the mode query went
unanswered), 4 setup failure (bad arguments, a model with no row, a Python
without D-Bus).

The battery is not this bridge's: these earbuds send left, right and case on
the Fast Pair Message Stream, and gfps-reader reads it there.

Protocol, as an EarFun Air Pro 4 (firmware TW600-3091_20250919_v0.4.1)
answered it (docs/captures/earfun-air-pro-4.txt). The command numbers are the
ones Gadgetbridge's EarFun support uses; only the ones these earbuds were seen
to answer are sent. Standard SPP (`00001101-…`), GAIA-style frames with no
checksum:

    frame    FF <version> <flags> <len u8> <vendor u16 BE> <command u16 BE> <payload>
             what is sent:      version 04, flags 00, vendor 000A
             what came back:    version 03, flags 00, vendor 000A
    get      command 0315, no payload. The answer is command 8315 (the ack
             bit 0x8000 set) with the payload <status 00> <value>:
             00 off, 01 noise cancelling, 02 transparency
    set      command 0314, payload <value>. No acknowledgement and no
             announcement follow: the new value is only known by asking again.
             Until the change is done (0.7 to 2.1 s after the set in the
             capture) the get still answers the old value, so the bridge asks
             every RECHECK_MS, up to RECHECKS times, until the earbuds report
             the mode that was set

The earbuds also send frames of their own on the channel (commands 034D, 0350,
0358, without the ack bit). They are framed and skipped, not read. A change of
mode on the earbuds themselves was not seen to be announced, so the mode is
asked for again every POLL_MS.

What is sent: the 0315 get, and on `set`, one 0314 set with 00, 01 or 02.
Nothing else.
"""
import ctypes
import json
import os
import re
import signal
import sys

try:
    import dbus
    import dbus.mainloop.glib
    import dbus.service
    from gi.repository import GLib
except ImportError as error:
    sys.stdout.write(json.dumps({
        "modes": False,
        "error": "missing python dependency %s"
                 % (getattr(error, "name", None) or error),
    }) + "\n")
    sys.stdout.flush()
    sys.exit(4)

try:
    from gi.repository import GLibUnix
    unix_signal_add = GLibUnix.signal_add
except ImportError:
    unix_signal_add = GLib.unix_signal_add

USAGE = "usage: earfun-bridge <classic-address> <reported-name>"
UUID = "00001101-0000-1000-8000-00805f9b34fb"
PROFILE_PATH = "/io/github/ncr/omaphones/earfun"
ADDRESS = re.compile(r"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$")

# Keyed by the name the earbuds report, exactly as bluetoothctl prints it. A
# model nobody has held has no row: its values may not mean the same.
MODELS = {
    "EarFun Air Pro 4": {"available": ["off", "anc", "ambient"]},
}

SOP = 0xFF
VERSION_SENT = 0x04
VERSION_SEEN = 0x03
FLAGS = 0x00
VENDOR = 0x000A
HEADER = 8
ACK = 0x8000
GET_AMBIENT_SOUND = 0x0315
SET_AMBIENT_SOUND = 0x0314
STATUS_OK = 0x00

MODE_FROM_VALUE = {0x00: "off", 0x01: "anc", 0x02: "ambient"}
VALUE_FROM_MODE = {mode: value for value, mode in MODE_FROM_VALUE.items()}

EXIT_TRANSIENT = 1
EXIT_UNSUPPORTED = 3
EXIT_SETUP = 4
REPLY_TIMEOUT = 5
CONNECT_TIMEOUT = 30
CONNECT_DELAY = 500
# As sony-bridge: the first ConnectProfile after the earbuds connect may fail
# with br-connection-busy while bluetoothd finishes its own setup.
CONNECT_RETRY = 1500
CONNECT_ATTEMPTS = 10
# The get was answered in 20-50 ms in the capture. One more ask before giving up.
ASK_AGAIN_MS = 2000
FIRST_ANSWER_MS = 5000
# The new value read back 0.7 to 2.1 s after a set; until then, the old one.
RECHECK_MS = 1000
RECHECKS = 5
POLL_MS = 10000


def emit(payload):
    try:
        sys.stdout.write(json.dumps(payload, separators=(",", ":")) + "\n")
        sys.stdout.flush()
    except (BrokenPipeError, ValueError):
        os._exit(0)


def arm_parent_death_signal():
    try:
        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        libc.prctl(1, signal.SIGTERM)
    except Exception:
        return
    if os.getppid() == 1:
        os._exit(0)


# ---- Frames

def encode(command, payload=b""):
    return (bytes([SOP, VERSION_SENT, FLAGS, len(payload)])
            + VENDOR.to_bytes(2, "big") + command.to_bytes(2, "big") + payload)


def encode_get_mode():
    return encode(GET_AMBIENT_SOUND)


def encode_set_mode(mode):
    return encode(SET_AMBIENT_SOUND, bytes([VALUE_FROM_MODE[mode]]))


def split_frame(buffer):
    """Take one frame the earbuds could have sent off the front of buffer.

    Returns (frame, rest). frame is None while more bytes are needed. A start
    byte not followed by the version and flags seen from the earbuds is not a
    frame start: one byte is dropped and the search goes on, so garbage cannot
    stall the loop. The length is one byte, so no length is absurd.
    """
    buffer = bytearray(buffer)
    while True:
        start = buffer.find(bytes([SOP]))
        if start < 0:
            return None, bytearray()
        del buffer[:start]
        if len(buffer) >= 2 and buffer[1] != VERSION_SEEN:
            del buffer[:1]
            continue
        if len(buffer) >= 3 and buffer[2] != FLAGS:
            del buffer[:1]
            continue
        if len(buffer) < HEADER:
            return None, buffer
        total = HEADER + buffer[3]
        if len(buffer) < total:
            return None, buffer
        frame = bytes(buffer[:total])
        del buffer[:total]
        return frame, buffer


def parts_of(frame):
    """(vendor, command, payload) of a whole frame."""
    return (int.from_bytes(frame[4:6], "big"), int.from_bytes(frame[6:8], "big"),
            frame[HEADER:])


def mode_of(frame):
    """The mode an answer to the get carries, or None.

    Only the answer: vendor 000A, command 8315, status 00 and a value that was
    seen. Our own get, echoed, has no ack bit and the wrong version."""
    if len(frame) < HEADER or frame[0] != SOP or frame[1] != VERSION_SEEN:
        return None
    vendor, command, payload = parts_of(frame)
    if vendor != VENDOR or command != (GET_AMBIENT_SOUND | ACK):
        return None
    if len(payload) != 2 or payload[0] != STATUS_OK:
        return None
    return MODE_FROM_VALUE.get(payload[1])


class Bridge:
    def __init__(self, bus, address, name, loop):
        self.bus = bus
        self.address = address
        self.model = MODELS[name]
        self.loop = loop
        self.exit_code = None
        self.device = None
        self.manager = None
        self.registered = False
        self.fd = None
        self.watch = None
        self.buffer = bytearray()
        self.pending = ""
        self.mode = None
        self.last_line = None
        self.wanted = None
        self.rechecks = 0

    def finish(self, code, message=None):
        if self.exit_code is not None:
            return False
        self.exit_code = code
        if message:
            emit({"modes": False, "error": message})
        self.loop.quit()
        return False

    def unregister(self):
        if self.watch is not None:
            try:
                GLib.source_remove(self.watch)
            except Exception:
                pass
            self.watch = None
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None
        if self.manager is not None and self.registered:
            try:
                self.manager.UnregisterProfile(PROFILE_PATH, timeout=REPLY_TIMEOUT)
            except dbus.DBusException:
                pass
            self.registered = False

    def register(self):
        try:
            device_path = find_device_path(self.bus, self.address)
        except dbus.DBusException as error:
            return self.finish(EXIT_TRANSIENT,
                               "cannot reach BlueZ: %s" % error.get_dbus_message())
        if not device_path:
            return self.finish(EXIT_TRANSIENT,
                               "no paired device with address %s" % self.address)
        self.device = dbus.Interface(
            self.bus.get_object("org.bluez", device_path), "org.bluez.Device1")
        self.manager = dbus.Interface(
            self.bus.get_object("org.bluez", "/org/bluez"), "org.bluez.ProfileManager1")
        try:
            self.manager.RegisterProfile(PROFILE_PATH, UUID, {
                "Name": "Omaphones EarFun",
                "Role": "client",
                "RequireAuthentication": dbus.Boolean(False),
                "RequireAuthorization": dbus.Boolean(False),
                "AutoConnect": dbus.Boolean(False),
            }, timeout=REPLY_TIMEOUT)
        except dbus.DBusException as error:
            return self.finish(EXIT_TRANSIENT,
                               "cannot register the EarFun profile: %s"
                               % error.get_dbus_message())
        self.registered = True
        GLib.timeout_add(CONNECT_DELAY, self.connect, 0)
        return False

    def connect(self, attempt):
        if self.exit_code is not None or self.fd is not None:
            return False

        def failed(error):
            if self.exit_code is not None or self.fd is not None:
                return
            if attempt + 1 < CONNECT_ATTEMPTS:
                GLib.timeout_add(CONNECT_RETRY, self.connect, attempt + 1)
                return
            self.finish(EXIT_TRANSIENT, "cannot open the EarFun channel: %s"
                        % error.get_dbus_message())

        try:
            self.device.ConnectProfile(UUID, reply_handler=lambda: None,
                                       error_handler=failed, timeout=CONNECT_TIMEOUT)
        except dbus.DBusException as error:
            failed(error)
        return False

    def opened(self, fd):
        if self.fd is not None or self.exit_code is not None:
            try:
                os.close(fd)
            except OSError:
                pass
            return
        self.fd = fd
        self.watch = GLib.io_add_watch(fd, GLib.PRIORITY_DEFAULT,
                                       GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
                                       self.on_io)
        self.ask()
        GLib.timeout_add(ASK_AGAIN_MS, self.ask_again)
        GLib.timeout_add(FIRST_ANSWER_MS, self.first_answer_timeout)
        GLib.timeout_add(POLL_MS, self.poll)

    def ask(self):
        self.write(encode_get_mode())
        return False

    def ask_again(self):
        if self.mode is None:
            self.ask()
        return False

    def poll(self):
        if self.exit_code is not None or self.fd is None:
            return False
        self.ask()
        return True

    def first_answer_timeout(self):
        # Linked, asked twice, and nothing came back: the channel is served
        # but not this part of it, so the address is parked, exit code 3.
        if self.exit_code is None and self.mode is None:
            self.finish(EXIT_UNSUPPORTED, "the EarFun earbuds did not answer")
        return False

    def write(self, frame):
        if self.fd is None or self.exit_code is not None:
            return
        try:
            written = 0
            while written < len(frame):
                written += os.write(self.fd, frame[written:])
        except OSError as error:
            self.finish(EXIT_TRANSIENT, "the EarFun channel closed: %s" % error)

    def on_frame(self, frame):
        mode = mode_of(frame)
        if mode is None or mode not in self.model["available"]:
            return
        self.mode = mode
        line = {"modes": True, "mode": mode, "available": self.model["available"]}
        if line != self.last_line:
            self.last_line = line
            emit(line)

    def parse_buffer(self):
        while self.exit_code is None:
            frame, self.buffer = split_frame(self.buffer)
            if frame is None:
                return
            self.on_frame(frame)

    def command(self, line):
        parts = line.strip().split()
        if len(parts) != 2 or parts[0] != "set":
            return
        if parts[1] not in self.model["available"]:
            return
        # Nothing is sent before the earbuds have said what they are set to.
        if self.mode is None or self.exit_code is not None:
            return
        self.write(encode_set_mode(parts[1]))
        self.wanted = parts[1]
        if self.rechecks == 0:
            GLib.timeout_add(RECHECK_MS, self.recheck)
        self.rechecks = RECHECKS

    def recheck(self):
        # One timer at a time: a second set refills the count rather than
        # starting a second train of asks.
        if self.exit_code is not None or self.fd is None:
            self.rechecks = 0
            return False
        if self.mode == self.wanted or self.rechecks <= 0:
            self.rechecks = 0
            return False
        self.rechecks -= 1
        self.ask()
        return True

    def on_io(self, _fd, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self.finish(EXIT_TRANSIENT, "the EarFun channel closed")
            return False
        try:
            data = os.read(self.fd, 4096)
        except OSError as error:
            self.finish(EXIT_TRANSIENT, "the EarFun channel closed: %s" % error)
            return False
        if not data:
            self.finish(EXIT_TRANSIENT, "the EarFun channel closed")
            return False
        self.buffer += data
        self.parse_buffer()
        return self.exit_code is None

    def listen_to_stdin(self):
        GLib.io_add_watch(0, GLib.PRIORITY_DEFAULT,
                          GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.on_stdin)

    def on_stdin(self, _fd, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self.finish(0)
            return False
        try:
            chunk = os.read(0, 4096)
        except OSError:
            self.finish(0)
            return False
        if not chunk:
            self.finish(0)
            return False
        self.pending += chunk.decode("utf-8", "replace")
        while "\n" in self.pending:
            line, self.pending = self.pending.split("\n", 1)
            self.command(line)
        return True


def find_device_path(bus, address):
    """The device's object path. With more than one adapter the same address
    can sit under each, and the one it is connected through is the one to ask."""
    wanted = address.upper()
    objects = dbus.Interface(bus.get_object("org.bluez", "/"),
                             "org.freedesktop.DBus.ObjectManager").GetManagedObjects()
    found = []
    for path, interfaces in sorted(objects.items()):
        device = interfaces.get("org.bluez.Device1")
        if device and str(device.get("Address", "")).upper() == wanted:
            found.append((not bool(device.get("Connected", False)), str(path)))
    return min(found)[1] if found else None


def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    address = argv[0].strip() if argv else ""
    if not ADDRESS.match(address):
        emit({"modes": False,
              "error": "%s (not a Bluetooth address: %r)" % (USAGE, address)})
        sys.exit(EXIT_SETUP)
    name = argv[1] if len(argv) > 1 else ""
    if name not in MODELS:
        emit({"modes": False,
              "error": "%s (no row for the model %r)" % (USAGE, name)})
        sys.exit(EXIT_SETUP)

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    try:
        bus = dbus.SystemBus()
    except dbus.DBusException as error:
        emit({"modes": False, "error": "no system bus: %s" % error.get_dbus_message()})
        sys.exit(EXIT_TRANSIENT)

    loop = GLib.MainLoop()
    bridge = Bridge(bus, address, name, loop)

    class Profile(dbus.service.Object):
        @dbus.service.method("org.bluez.Profile1", in_signature="", out_signature="")
        def Release(self):
            bridge.finish(EXIT_TRANSIENT, "BlueZ released the EarFun profile")

        @dbus.service.method("org.bluez.Profile1", in_signature="oha{sv}",
                             out_signature="")
        def NewConnection(self, path, fd, properties):
            bridge.opened(fd.take())

        @dbus.service.method("org.bluez.Profile1", in_signature="o", out_signature="")
        def RequestDisconnection(self, path):
            bridge.finish(EXIT_TRANSIENT, "the EarFun channel closed")

    Profile(bus, PROFILE_PATH)
    bridge.listen_to_stdin()
    bridge.register()

    def stop(*_args):
        bridge.finish(0)
        return False

    unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, stop)
    unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, stop)

    try:
        if bridge.exit_code is None:
            loop.run()
    finally:
        bridge.unregister()
    sys.exit(bridge.exit_code or 0)


if __name__ == "__main__":
    arm_parent_death_signal()
    try:
        main()
    except SystemExit:
        raise
    except KeyboardInterrupt:
        pass
    except BaseException as error:
        emit({"modes": False, "error": "%s: %s" % (type(error).__name__, error)})
        sys.exit(EXIT_TRANSIENT)
