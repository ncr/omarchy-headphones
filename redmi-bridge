#!/usr/bin/env python3
"""Hold one 0xFD2D RFCOMM link to Redmi Buds: battery and noise control.

    redmi-bridge <classic-address> [<reported-name>]

Without a name the bridge is what the Redmi Buds 5 have always been started
with, and does what it always did. A name picks a row in MODELS; a name with
no row is exit 4.

Prints one JSON object per line, and reads one command per line:

    stdout   {"modes": true, "mode": "anc",
              "available": ["off","anc","ambient"],
              "battery": {"left": 75, "right": 80, "case": 100,
                          "charging": []}}
             {"modes": false, "error": "..."}
    stdin    set off | set anc | set ambient

Exit codes are BRIDGE.md's: 0 clean stop, 1 transient (the channel never
opened, or closed under us; also refused, since the earbuds may serve the
channel to one client and the phone's Xiaomi Earbuds app holding it is the
likely case), 3 linked but silent (nothing answered), 4 setup failure
(bad arguments, a Python without D-Bus).

Protocol, as the Redmi Buds 5 answered it, and as the Xiaomi Earbuds app
(com.mi.earphone 1.38.0) reads it: RCSP on the SPP service
`0000fd2d-0000-1000-8000-00805f9b34fb`.

    frame    FE DC BA <flags> <opcode> <len u16 BE> <body> EF
             flags: 0x80 = command, 0x40 = wants a response
             a command's body is  <sn> <param>
             a response's body is <status> <sn> <payload>
    battery  ask FE DC BA C0 02 00 05 <sn> FF FF FF FF EF (GetTargetInfo);
             attribute 7 of the answer, a <length> <type> <value> list, is one
             byte each for left, right, case: the level in the low seven bits,
             and bit 7 for charging, 0xFF for no reading. The level was seen;
             the other two are how the Xiaomi Earbuds app reads the byte, and
             no earbud was charging or out of range in the capture
    config   a config is <len> <id u16 BE> <value>, len counting the id and
             the value. Config 11 is the noise control: <state> <level>,
             state 0 off, 1 noise cancelling, 2 transparency
             get   opcode F3, param <id u16 BE>; the answer is a response
                   carrying the config
             set   opcode F2, param the config; answered by a response with
                   status 0, and the earbuds then announce the new state on
                   their own, as opcode F4 carrying the config
    level    the second byte of config 11 is the strength inside a state
             (balanced, comfortable, deep, ... for cancelling). Every set
             sends the level this state was last seen at, or 0

Authentication, for a model whose row asks for it (the Redmi Buds 3 Pro, which
answer nothing on the channel until it is done), as the earbuds answered it and
as Gadgetbridge's Redmi Buds support first described it:

    ours     -> C4 50 <sn> 01 <16-byte random challenge>
             <- 04 50 <status> <sn> 01 <their response>, checked against
                our own computation before anything else is sent
             -> C4 51 <sn> 01 00
             <- 04 51 <status> <sn> 01
    theirs   <- C0 50 <sn> 01 <16-byte challenge>
             -> 04 50 00 <sn> 01 <our response>
             <- C0 51 <sn> 01 00
             -> 04 51 00 <sn> 01
    response SAFER+ Ar' (the Bluetooth E1 block cipher) keyed by the
             challenge, with its last byte XOR 6, over a fixed 16-byte
             block, 11 22 33 33 22 11 repeated

Once both sides have confirmed, the reads and sets below are the Buds 5's,
byte for byte, and are answered the same way.

Acknowledgement, for a model whose row asks for it (the Buds 3 Pro again): the
earbuds repeat each of their own announcements (opcodes 0E and F4) every two
seconds until it is answered, so a mode they announced earlier comes back after
a later one. Each is answered with an empty response carrying its sn,
`04 <opcode> 00 02 00 <sn>`, after which it was not heard again.

Battery in the status report, for a model whose row asks for it (the Buds 3
Pro): their 0E reports are `<length> <type> <value>` attributes like
GetTargetInfo's, and type 0 is the same three battery bytes, sent on their own
whenever a level changes or a bud goes into the case (where it read
`ff ff ff`, then `dc 5c 2c`: left 92 and charging).

What is sent: the authentication and the acknowledgements above where the row
asks for them, the battery ask, the config 11 get, and, on `set`, one config 11
set. Nothing else; without a row, no answer to the earbuds' own announcements:
the Buds 5 were not seen to need one. Without a row the status report (opcode
0x0E) is not read: it carried no battery in the Buds 5's capture.
"""
import ctypes
import json
import os
import re
import signal
import sys

try:
    import dbus
    import dbus.mainloop.glib
    import dbus.service
    from gi.repository import GLib
except ImportError as error:
    sys.stdout.write(json.dumps({
        "modes": False,
        "error": "missing python dependency %s"
                 % (getattr(error, "name", None) or error),
    }) + "\n")
    sys.stdout.flush()
    sys.exit(4)

try:
    from gi.repository import GLibUnix
    unix_signal_add = GLibUnix.signal_add
except ImportError:
    unix_signal_add = GLib.unix_signal_add

UUID = "0000fd2d-0000-1000-8000-00805f9b34fb"
PROFILE_PATH = "/io/github/ncr/omaphones/redmi"
ADDRESS = re.compile(r"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$")

HEADER = b"\xFE\xDC\xBA"
TAIL = 0xEF
FLAG_COMMAND = 0x80
FLAG_WANTS_RESPONSE = 0x40
FLAG_APP = 0x04
OP_GET_TARGET_INFO = 0x02
OP_SET_CONFIG = 0xF2
OP_GET_CONFIG = 0xF3
OP_NOTIFY_CONFIG = 0xF4
OP_AUTH_CHALLENGE = 0x50
OP_AUTH_CONFIRM = 0x51
ATTR_BATTERY_INFO = 7
NO_READING = 0xFF
PARTS = ("left", "right", "case")

CONFIG_NOISE = 11
MODE_FROM_STATE = {0: "off", 1: "anc", 2: "ambient"}
STATE_FROM_MODE = {mode: state for state, mode in MODE_FROM_STATE.items()}
AVAILABLE = ["off", "anc", "ambient"]

# A row per model that needs something the Buds 5 do not, keyed by the name the
# earbuds report. The Buds 5 have no row: they are started without a name.
NAMELESS = {"authenticate": False, "acknowledge": False, "status_battery": False}
MODELS = {
    "Redmi Buds 3 Pro": {"authenticate": True, "acknowledge": True,
                         "status_battery": True},
}
# The earbuds' own announcements, which a row with "acknowledge" answers.
OP_REPORT_STATUS = 0x0E
ANNOUNCEMENTS = (OP_REPORT_STATUS, OP_NOTIFY_CONFIG)
STATUS_BATTERY = 0

EXIT_TRANSIENT = 1
EXIT_UNSUPPORTED = 3
EXIT_SETUP = 4
REPLY_TIMEOUT = 5
CONNECT_TIMEOUT = 30
CONNECT_DELAY = 500
FIRST_ANSWER_MS = 5000
MODE_GRACE_MS = 2000
POLL_MS = 30000
RECHECK_MS = 800
MAX_BODY = 1024

def emit(payload):
    try:
        sys.stdout.write(json.dumps(payload, separators=(",", ":")) + "\n")
        sys.stdout.flush()
    except (BrokenPipeError, ValueError):
        os._exit(0)


def arm_parent_death_signal():
    try:
        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        libc.prctl(1, signal.SIGTERM)
    except Exception:
        return
    if os.getppid() == 1:
        os._exit(0)


# ---- Frames

def encode(opcode, sn, param=b"", flags=FLAG_COMMAND | FLAG_WANTS_RESPONSE):
    body = bytes([sn & 0xFF]) + param
    return (HEADER + bytes([flags, opcode]) + len(body).to_bytes(2, "big")
            + body + bytes([TAIL]))


def encode_get_target_info(sn):
    return encode(OP_GET_TARGET_INFO, sn, b"\xFF\xFF\xFF\xFF")


def encode_get_noise(sn):
    return encode(OP_GET_CONFIG, sn, CONFIG_NOISE.to_bytes(2, "big"))


def encode_set_noise(sn, state, level):
    config = bytes([4]) + CONFIG_NOISE.to_bytes(2, "big") + bytes([state, level])
    return encode(OP_SET_CONFIG, sn, config)


def encode_response(opcode, sn, payload=b""):
    """Our answer to a command the earbuds sent: status 0, their sn."""
    body = b"\x00" + bytes([sn & 0xFF]) + payload
    return (HEADER + bytes([FLAG_APP, opcode]) + len(body).to_bytes(2, "big")
            + body + bytes([TAIL]))


def encode_auth_challenge(sn, challenge):
    return encode(OP_AUTH_CHALLENGE, sn, b"\x01" + challenge,
                  flags=FLAG_COMMAND | FLAG_WANTS_RESPONSE | FLAG_APP)


def encode_auth_confirm(sn):
    return encode(OP_AUTH_CONFIRM, sn, b"\x01\x00",
                  flags=FLAG_COMMAND | FLAG_WANTS_RESPONSE | FLAG_APP)


# ---- Authentication: SAFER+ as Bluetooth's Ar' (Core spec, E1), 8 rounds.

def _safer_tables():
    exp = [0 if i == 128 else pow(45, i, 257) for i in range(256)]
    log = [0] * 256
    for i, value in enumerate(exp):
        log[value] = i
    log[0] = 128
    bias = [[0] * 16 for _ in range(16)]
    for i in range(16):
        for j in range(16):
            value = pow(45, pow(45, 17 * (i + 2) + j + 1, 257), 257)
            bias[i][j] = 0 if value == 256 else value
    return exp, log, bias


SAFER_EXP, SAFER_LOG, SAFER_BIAS = _safer_tables()
# Which of the 16 bytes take XOR (the rest take addition), byte 0 first.
SAFER_XOR = [bool(0x9999 >> i & 1) for i in range(16)]
# The Pseudo-Hadamard layer of SAFER+, row i giving output byte i.
SAFER_PHT = [
    [2, 1, 1, 1, 4, 2, 1, 1, 2, 2, 4, 2, 4, 4, 16, 8],
    [2, 1, 1, 1, 4, 2, 1, 1, 1, 1, 2, 1, 2, 2, 8, 4],
    [1, 1, 4, 2, 2, 2, 4, 2, 16, 8, 4, 4, 2, 1, 1, 1],
    [1, 1, 4, 2, 1, 1, 2, 1, 8, 4, 2, 2, 2, 1, 1, 1],
    [16, 8, 2, 2, 4, 2, 4, 4, 1, 1, 4, 2, 1, 1, 2, 1],
    [8, 4, 1, 1, 2, 1, 2, 2, 1, 1, 4, 2, 1, 1, 2, 1],
    [2, 2, 4, 2, 4, 4, 16, 8, 2, 1, 1, 1, 4, 2, 1, 1],
    [1, 1, 2, 1, 2, 2, 8, 4, 2, 1, 1, 1, 4, 2, 1, 1],
    [4, 2, 4, 4, 16, 8, 2, 2, 1, 1, 2, 1, 1, 1, 4, 2],
    [2, 1, 2, 2, 8, 4, 1, 1, 1, 1, 2, 1, 1, 1, 4, 2],
    [4, 4, 16, 8, 1, 1, 2, 1, 4, 2, 1, 1, 4, 2, 2, 2],
    [2, 2, 8, 4, 1, 1, 2, 1, 4, 2, 1, 1, 2, 1, 1, 1],
    [1, 1, 2, 1, 1, 1, 4, 2, 4, 4, 16, 8, 2, 2, 4, 2],
    [1, 1, 2, 1, 1, 1, 4, 2, 2, 2, 8, 4, 1, 1, 2, 1],
    [4, 2, 1, 1, 2, 1, 1, 1, 4, 2, 2, 2, 16, 8, 4, 4],
    [4, 2, 1, 1, 2, 1, 1, 1, 2, 1, 1, 1, 8, 4, 2, 2],
]
AUTH_BLOCK = bytes([0x11, 0x22, 0x33, 0x33, 0x22, 0x11] * 2 + [0x11, 0x22, 0x33, 0x33])


def _mix(a, b, xor):
    return [(x ^ y) if use_xor else (x + y) & 0xFF
            for x, y, use_xor in zip(a, b, xor)]


def auth_response(challenge):
    """The 16 bytes that answer a 16-byte challenge."""
    key = list(bytes(challenge))
    key[15] ^= 6
    register = key + [0]
    for byte in key:
        register[16] ^= byte
    keys = [key]
    for k in range(1, 17):
        register = [((byte >> 5) | (byte << 3)) & 0xFF for byte in register]
        keys.append([(register[(k + i) % 17] + SAFER_BIAS[k - 1][i]) & 0xFF
                     for i in range(16)])
    plain = list(AUTH_BLOCK)
    block = list(plain)
    inverse = [not use_xor for use_xor in SAFER_XOR]
    for r in range(8):
        if r == 2:
            block = _mix(block, plain, SAFER_XOR)
        block = _mix(block, keys[2 * r], SAFER_XOR)
        block = [SAFER_EXP[b] if use_xor else SAFER_LOG[b]
                 for b, use_xor in zip(block, SAFER_XOR)]
        block = _mix(block, keys[2 * r + 1], inverse)
        block = [sum(c * b for c, b in zip(row, block)) & 0xFF for row in SAFER_PHT]
    return bytes(_mix(block, keys[16], SAFER_XOR))


def split_frame(buffer):
    """Take one frame off the front of buffer.

    Returns (frame, rest). frame is None while more bytes are needed. Bytes
    before a header are dropped, and a length or tail that cannot belong to a
    frame of this protocol drops one byte and looks again, so garbage cannot
    stall the loop.
    """
    buffer = bytearray(buffer)
    while True:
        start = buffer.find(HEADER)
        if start < 0:
            return None, buffer[-2:]
        del buffer[:start]
        if len(buffer) < 7:
            return None, buffer
        size = int.from_bytes(buffer[5:7], "big")
        if size > MAX_BODY:
            del buffer[:1]
            continue
        total = 8 + size
        if len(buffer) < total:
            return None, buffer
        if buffer[total - 1] != TAIL:
            del buffer[:1]
            continue
        frame = bytes(buffer[:total])
        del buffer[:total]
        return frame, buffer


def parts_of(frame):
    """(is_command, opcode, status, payload) of a whole frame.

    A command's body is <sn> <payload>; a response's is <status> <sn>
    <payload>, and a command has no status, so None."""
    flags = frame[3]
    opcode = frame[4]
    body = frame[7:-1]
    if flags & FLAG_COMMAND:
        return True, opcode, None, body[1:]
    if len(body) < 2:
        return False, opcode, None, b""
    return False, opcode, body[0], body[2:]


def attributes(data):
    """The <length> <type> <value> list as {type: bytes}; stops at damage."""
    out = {}
    index = 0
    while index + 2 <= len(data):
        length = data[index]
        if length <= 0 or index + 1 + length > len(data):
            break
        out[data[index + 1]] = bytes(data[index + 2:index + 1 + length])
        index += 1 + length
    return out


def configs(data):
    """The <len> <id u16 BE> <value> list as {id: bytes}; stops at damage."""
    out = {}
    index = 0
    while index + 3 <= len(data):
        length = data[index]
        if length < 2 or index + 1 + length > len(data):
            break
        out[int.from_bytes(data[index + 1:index + 3], "big")] = \
            bytes(data[index + 3:index + 1 + length])
        index += 1 + length
    return out


def battery_from(values):
    """{"left", "right", "case", "charging"} from one byte per part, or None."""
    battery = {}
    charging = []
    for name, byte in zip(PARTS, values):
        if byte == NO_READING:
            continue
        level = byte & 0x7F
        if level > 100:
            continue
        battery[name] = level
        if byte & 0x80:
            charging.append(name)
    if not battery:
        return None
    battery["charging"] = charging
    return battery


def battery_of(frame):
    """The battery a frame carries, or None for one that has none to give."""
    is_command, opcode, status, payload = parts_of(frame)
    if is_command or opcode != OP_GET_TARGET_INFO or status != 0:
        return None
    values = attributes(payload).get(ATTR_BATTERY_INFO)
    return battery_from(values) if values else None


def status_battery_of(frame):
    """The battery an earbuds' status report carries, or None."""
    is_command, opcode, _status, payload = parts_of(frame)
    if not is_command or opcode != OP_REPORT_STATUS:
        return None
    values = attributes(payload).get(STATUS_BATTERY)
    return battery_from(values) if values and len(values) == 3 else None


def noise_of(frame):
    """(state, level) of the noise control a frame carries, or None."""
    is_command, opcode, status, payload = parts_of(frame)
    if is_command:
        if opcode != OP_NOTIFY_CONFIG:
            return None
    elif opcode != OP_GET_CONFIG or status != 0:
        return None
    value = configs(payload).get(CONFIG_NOISE)
    if value is None or len(value) < 2 or value[0] not in MODE_FROM_STATE:
        return None
    return value[0], value[1]


class Bridge:
    def __init__(self, bus, address, loop, model=NAMELESS):
        self.bus = bus
        self.address = address
        self.loop = loop
        self.model = model
        self.exit_code = None
        self.device = None
        self.manager = None
        self.registered = False
        self.fd = None
        self.watch = None
        self.buffer = bytearray()
        self.pending = ""
        self.sn = 0
        self.answered = False
        self.grace_over = False
        self.last_line = None
        self.mode = None
        self.levels = {}
        self.battery = None
        # Authentication: nothing but it goes out until both sides confirmed.
        self.authenticated = not model["authenticate"]
        self.make_challenge = new_challenge
        self.challenge = None
        self.ours_verified = False
        self.theirs_confirmed = False

    def finish(self, code, message=None):
        if self.exit_code is not None:
            return False
        self.exit_code = code
        if message:
            emit({"modes": False, "error": message})
        self.loop.quit()
        return False

    def unregister(self):
        if self.watch is not None:
            try:
                GLib.source_remove(self.watch)
            except Exception:
                pass
            self.watch = None
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None
        if self.manager is not None and self.registered:
            try:
                self.manager.UnregisterProfile(PROFILE_PATH, timeout=REPLY_TIMEOUT)
            except dbus.DBusException:
                pass
            self.registered = False

    def register(self):
        try:
            device_path = find_device_path(self.bus, self.address)
        except dbus.DBusException as error:
            return self.finish(EXIT_TRANSIENT,
                               "cannot reach BlueZ: %s" % error.get_dbus_message())
        if not device_path:
            return self.finish(EXIT_TRANSIENT,
                               "no paired device with address %s" % self.address)
        self.device = dbus.Interface(
            self.bus.get_object("org.bluez", device_path), "org.bluez.Device1")
        self.manager = dbus.Interface(
            self.bus.get_object("org.bluez", "/org/bluez"), "org.bluez.ProfileManager1")
        try:
            self.manager.RegisterProfile(PROFILE_PATH, UUID, {
                "Name": "Omaphones Redmi",
                "Role": "client",
                "Channel": dbus.UInt16(0),
                "RequireAuthentication": dbus.Boolean(False),
                "RequireAuthorization": dbus.Boolean(False),
                "AutoConnect": dbus.Boolean(False),
            }, timeout=REPLY_TIMEOUT)
        except dbus.DBusException as error:
            return self.finish(EXIT_TRANSIENT,
                               "cannot register the Redmi profile: %s"
                               % error.get_dbus_message())
        self.registered = True
        GLib.timeout_add(CONNECT_DELAY, self.connect)
        return False

    def connect(self):
        if self.exit_code is not None or self.fd is not None:
            return False

        def failed(error):
            if self.exit_code is not None or self.fd is not None:
                return
            self.finish(EXIT_TRANSIENT, "cannot open the Redmi channel: %s"
                        % error.get_dbus_message())

        try:
            self.device.ConnectProfile(UUID, reply_handler=lambda: None,
                                       error_handler=failed, timeout=CONNECT_TIMEOUT)
        except dbus.DBusException as error:
            failed(error)
        return False

    def opened(self, fd):
        if self.fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
            return
        self.fd = fd
        self.watch = GLib.io_add_watch(fd, GLib.PRIORITY_DEFAULT,
                                       GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
                                       self.on_io)
        if self.authenticated:
            self.ask()
        else:
            self.challenge = self.make_challenge()
            self.write(encode_auth_challenge(self.next_sn(), self.challenge))
        GLib.timeout_add(FIRST_ANSWER_MS, self.first_answer_timeout)
        GLib.timeout_add(MODE_GRACE_MS, self.grace_timeout)
        GLib.timeout_add(POLL_MS, self.poll)

    def next_sn(self):
        self.sn = (self.sn + 1) & 0xFF
        return self.sn

    def ask(self):
        if self.exit_code is not None or not self.authenticated:
            return
        self.write(encode_get_noise(self.next_sn()))
        self.write(encode_get_target_info(self.next_sn()))

    def poll(self):
        if self.exit_code is not None or self.fd is None:
            return False
        self.ask()
        return True

    def recheck(self):
        if self.exit_code is None and self.fd is not None and self.authenticated:
            self.write(encode_get_noise(self.next_sn()))
        return False

    def first_answer_timeout(self):
        # Linked, asked, and nothing came back: the channel is served but not
        # this part of it, so the address is parked, exit code 3.
        if self.exit_code is None and not self.answered:
            self.finish(EXIT_UNSUPPORTED, "the Redmi Buds did not answer")
        return False

    def grace_timeout(self):
        # The mode had its chance to arrive with the battery; if it has not,
        # the battery goes out alone rather than not at all.
        self.grace_over = True
        self.publish()
        return False

    def write(self, frame):
        if self.fd is None or self.exit_code is not None:
            return
        try:
            written = 0
            while written < len(frame):
                written += os.write(self.fd, frame[written:])
        except OSError as error:
            self.finish(EXIT_TRANSIENT, "the Redmi channel closed: %s" % error)

    def publish(self):
        if self.mode is None and self.battery is None:
            return
        if self.mode is None and not self.grace_over:
            return
        line = {"modes": True, "available": AVAILABLE if self.mode else []}
        if self.mode:
            line["mode"] = self.mode
        if self.battery:
            line["battery"] = self.battery
        if line != self.last_line:
            self.last_line = line
            emit(line)

    def on_auth_frame(self, frame):
        is_command, opcode, status, payload = parts_of(frame)
        if is_command:
            if opcode == OP_AUTH_CHALLENGE and len(payload) == 17 and payload[0] == 1:
                self.write(encode_response(OP_AUTH_CHALLENGE, frame[7],
                                           b"\x01" + auth_response(payload[1:])))
            elif opcode == OP_AUTH_CONFIRM and self.ours_verified:
                self.theirs_confirmed = True
                self.write(encode_response(OP_AUTH_CONFIRM, frame[7], b"\x01"))
        elif opcode == OP_AUTH_CHALLENGE and status is not None and self.challenge:
            if status != 0 or payload != b"\x01" + auth_response(self.challenge):
                self.finish(EXIT_UNSUPPORTED,
                            "the Redmi Buds did not answer the authentication")
                return
            self.ours_verified = True
            self.write(encode_auth_confirm(self.next_sn()))
        if self.ours_verified and self.theirs_confirmed:
            self.authenticated = True
            self.ask()

    def on_frame(self, frame):
        if self.exit_code is not None:
            return
        if not self.authenticated:
            self.on_auth_frame(frame)
            return
        if self.model["acknowledge"] and frame[3] & FLAG_COMMAND \
                and frame[3] & FLAG_WANTS_RESPONSE and frame[4] in ANNOUNCEMENTS:
            self.write(encode_response(frame[4], frame[7]))
        noise = noise_of(frame)
        if noise is not None:
            state, level = noise
            self.answered = True
            self.mode = MODE_FROM_STATE[state]
            self.levels[state] = level
            self.publish()
            return
        battery = battery_of(frame)
        if battery is None and self.model["status_battery"]:
            battery = status_battery_of(frame)
        if battery is not None:
            self.answered = True
            self.battery = battery
            self.publish()

    def command(self, line):
        parts = line.strip().split()
        if len(parts) != 2 or parts[0] != "set" or parts[1] not in STATE_FROM_MODE:
            return
        # Nothing is sent before the earbuds have said what they are set to.
        if self.mode is None or not self.authenticated:
            return
        if self.exit_code is not None:
            return
        state = STATE_FROM_MODE[parts[1]]
        self.write(encode_set_noise(self.next_sn(), state, self.levels.get(state, 0)))
        GLib.timeout_add(RECHECK_MS, self.recheck)

    def parse_buffer(self):
        while True:
            frame, self.buffer = split_frame(self.buffer)
            if frame is None:
                return
            self.on_frame(frame)
            if self.exit_code is not None:
                return

    def on_io(self, _fd, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self.finish(EXIT_TRANSIENT, "the Redmi channel closed")
            return False
        try:
            data = os.read(self.fd, 4096)
        except OSError as error:
            self.finish(EXIT_TRANSIENT, "the Redmi channel closed: %s" % error)
            return False
        if not data:
            self.finish(EXIT_TRANSIENT, "the Redmi channel closed")
            return False
        self.buffer += data
        self.parse_buffer()
        return self.exit_code is None

    def listen_to_stdin(self):
        GLib.io_add_watch(0, GLib.PRIORITY_DEFAULT,
                          GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.on_stdin)

    def on_stdin(self, _fd, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self.finish(0)
            return False
        try:
            chunk = os.read(0, 4096)
        except OSError:
            self.finish(0)
            return False
        if not chunk:
            self.finish(0)
            return False
        self.pending += chunk.decode("utf-8", "replace")
        while "\n" in self.pending:
            line, self.pending = self.pending.split("\n", 1)
            self.command(line)
        return True


def new_challenge():
    return os.urandom(16)


def find_device_path(bus, address):
    wanted = address.upper()
    objects = dbus.Interface(bus.get_object("org.bluez", "/"),
                             "org.freedesktop.DBus.ObjectManager").GetManagedObjects()
    for path, interfaces in objects.items():
        device = interfaces.get("org.bluez.Device1")
        if device and str(device.get("Address", "")).upper() == wanted:
            return str(path)
    return None


def main():
    argv = sys.argv[1:]
    address = argv[0].strip() if argv else ""
    if argv and argv[0] in ("-h", "--help"):
        print("usage: redmi-bridge <classic-address> [<reported-name>]")
        return 0
    if not argv or not ADDRESS.match(address):
        emit({"modes": False,
              "error": "usage: redmi-bridge <classic-address> [<reported-name>] "
                       "(not a Bluetooth address: %r)" % address})
        sys.exit(EXIT_SETUP)
    if len(argv) > 2:
        emit({"modes": False,
              "error": "usage: redmi-bridge <classic-address> [<reported-name>]"})
        sys.exit(EXIT_SETUP)
    if len(argv) == 2 and argv[1] not in MODELS:
        emit({"modes": False, "error": "no Redmi model row for %r" % argv[1]})
        sys.exit(EXIT_SETUP)
    model = MODELS[argv[1]] if len(argv) == 2 else NAMELESS

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    try:
        bus = dbus.SystemBus()
    except dbus.DBusException as error:
        emit({"modes": False, "error": "no system bus: %s" % error.get_dbus_message()})
        sys.exit(EXIT_TRANSIENT)

    loop = GLib.MainLoop()
    bridge = Bridge(bus, address, loop, model)

    class Profile(dbus.service.Object):
        @dbus.service.method("org.bluez.Profile1", in_signature="", out_signature="")
        def Release(self):
            bridge.finish(EXIT_TRANSIENT, "BlueZ released the Redmi profile")

        @dbus.service.method("org.bluez.Profile1", in_signature="oha{sv}",
                             out_signature="")
        def NewConnection(self, path, fd, properties):
            bridge.opened(fd.take())

        @dbus.service.method("org.bluez.Profile1", in_signature="o", out_signature="")
        def RequestDisconnection(self, path):
            bridge.finish(EXIT_TRANSIENT, "the Redmi channel closed")

    Profile(bus, PROFILE_PATH)
    bridge.listen_to_stdin()
    bridge.register()

    def stop(*_args):
        bridge.finish(0)
        return False

    unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, stop)
    unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, stop)

    try:
        if bridge.exit_code is None:
            loop.run()
    finally:
        bridge.unregister()
    sys.exit(bridge.exit_code or 0)


if __name__ == "__main__":
    arm_parent_death_signal()
    try:
        main()
    except SystemExit:
        raise
    except KeyboardInterrupt:
        pass
    except BaseException as error:
        emit({"modes": False, "error": "%s: %s" % (type(error).__name__, error)})
        sys.exit(EXIT_TRANSIENT)
